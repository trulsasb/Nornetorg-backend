# App
APP_MODE=live          # "test" or "live" — refuses to boot in live mode with placeholder JWT_SECRET

# Database
DATABASE_URL=postgresql://user:password@host:5432/nornetorg

# Bakgrunnsjobber
REDIS_URL=redis://localhost:6379/0

# Sikkerhet — generer en reell tilfeldig verdi, f.eks. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Fernet-nøkkel for kryptering av selgeres Vipps-kredensialer og lagrede
# betalingsmetode-referanser. Generer med:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Frontend URL
FRONTEND_URL=https://nornetorg.no

# Stripe — plattformens EGEN konto (Connect-onboarding av selgere OG
# provisjonstrekk fra selgeres lagrede betalingsmetode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Vipps — plattform-nivå default (selgere kobler opp sine egne, lagret kryptert i databasen)
VIPPS_BASE_URL=https://apitest.vipps.no

# Posten Norge / Bring
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=
